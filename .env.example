CI_ENVIRONMENT=development
app.baseURL='https://bantay-gamit.jrmsu-tc.online'

# Database connection
# In Docker/Coolify, DB_HOST must be the MySQL service's internal hostname,
# not localhost, because MySQL runs in a separate container.
DB_HOST=mysql-service-host
DB_DATABASE=bantay_gamit
DB_USERNAME=mysql
DB_PASSWORD=
DB_PORT=3306

database.default.DBDriver=MySQLi
database.default.DBPrefix=
